  m_Script: {fileID: 11500000, guid: 4adcac72487b1e34aa5d3edc54efc136, type: 3}
  m_Name: dialogo_5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Rana Dorada
    portrait: {fileID: 2704927991928300174, guid: cb88951471b02b646ae8963058cc7373, type: 3}
    text: Me has caido bien Miguel, me alegra que hayas llegado hasta aca.
  - speakerName: Miguel
    portrait: {fileID: -5202054706885358483, guid: a6869cb4915bd344eac43cb7806023d2, type: 3}
    text: Si a mi tambien, aunque me abandonaste
  - speakerName: Rana Dorada
    portrait: {fileID: 2704927991928300174, guid: cb88951471b02b646ae8963058cc7373, type: 3}
    text: No puedo seguir guiandote mas, aqui esta quien te ayudara a salir de esta
      selva espesa y volveras a tu hogar. Mucha suerte
  - speakerName: Miguel
    portrait: {fileID: 8012021918966755687, guid: a6869cb4915bd344eac43cb7806023d2, type: 3}
    text: Gracias, nos veremos luego.
