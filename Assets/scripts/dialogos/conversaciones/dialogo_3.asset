  lines:
  - speakerName: Rana
    portrait: {fileID: 2704927991928300174, guid: cb88951471b02b646ae8963058cc7373, type: 3}
    text: mira, como estas perdido te voy a presentar a alguien que te puede ayudar
  - speakerName: Rana
    portrait: {fileID: 2704927991928300174, guid: cb88951471b02b646ae8963058cc7373, type: 3}
    text: 'el puede responderte todas tus preguntas, asi que tu tranquilo, el hojascarin
